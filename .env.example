# Copy this to .env.local and fill in values. Do NOT commit secrets to git.

# Public application URL. Use http://localhost:3000 locally and HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase values safe for the browser. RLS must remain enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

# Server-only Getform endpoint. Replace with the endpoint from your Getform form.
GETFORM_ENDPOINT=https://getform.io/f/your-form-id
