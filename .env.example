# Copy this to .env.local and fill in values. Do NOT commit secrets to git.

# Public application URL. Use http://localhost:3000 locally and HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase values safe for the browser. RLS must remain enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

# Server-only Resend configuration. Never prefix the API key with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_resend_api_key
ENQUIRY_FROM_EMAIL=quotes@hasmmatcleaning.com
ENQUIRY_NOTIFICATION_TO=hasmmatcleaningservice@gmail.com
# Use a verified inbox that is actively monitored for replies.
ENQUIRY_REPLY_TO=hasmmatcleaningservice@gmail.com
